# 复制为 .env 后填写

# 数据库 / 缓存
DATABASE_URL=postgresql+asyncpg://atomcap:atomcap_dev@localhost:5432/atomcap
REDIS_URL=redis://localhost:6379/0

# LiteLLM 网关
LITELLM_BASE_URL=http://localhost:4000
LITELLM_MASTER_KEY=sk-atomcap-dev

# 模型厂商（按需填写）
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# 数据源 Connector
BOCHA_API_KEY=
QCC_APP_KEY=
QCC_SECRET_KEY=
TAVILY_API_KEY=

# 可观测（Langfuse 自部署或云版）
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# 应用
JWT_SECRET=change-me-in-production
ALLOW_OVERSEAS_MODELS=false   # 机构级开关：是否允许调用海外模型（数据出境合规）
