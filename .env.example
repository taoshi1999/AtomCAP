# 复制为 .env 后填写

# 数据库 / 缓存
DATABASE_URL=postgresql+asyncpg://atomcap:atomcap_dev@localhost:5432/atomcap
REDIS_URL=redis://localhost:6379/0

# LiteLLM 网关
LITELLM_BASE_URL=http://localhost:4000
LITELLM_MASTER_KEY=sk-atomcap-dev

# 模型厂商（按需填写）
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# 数据源 Connector
BOCHA_API_KEY=
QCC_APP_KEY=
QCC_SECRET_KEY=
TAVILY_API_KEY=

# 可观测（Langfuse 自部署或云版）
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# 应用
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# 开发回退：未携带凭证的请求按固定开发租户处理（前端登录 UI 接通前的过渡），生产必须 false
AUTH_DEV_FALLBACK=true
# 注：海外模型开关 allow_overseas_models 是机构级 DB 字段（institutions 表），不在环境变量配置
